<%layout('/layouts/boilerplate')-%>
<!--<h3>All Listings</h3><br>-->
<div id="filters">
    <div class="filters">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </div>
    <div class="filters">
        <div><i class="fa-brands fa-fort-awesome"></i></div>
        <p>Castles</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </div>
    <div class="filters">
        <div><i class="fa-solid fa-sailboat"></i></div>
        <p>Boat House</p>
    </div>
    <div class="tax-toggle">
        <div class="form-check-reverse form-switch"><!--form-check-reverse for switch to appear to the right of label-->
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>
<div class="row g-4">
    <% for(let listing of allListings) {%>
        <div class="col-lg-3 col-md-4 col-sm-12">
            <a href="/listings/<%=listing.id%>" class="listing-link">
            <div class="listing-card col" style="width: 20rem;">
                <img src="<%=listing.image.url%>" class="card-img-top" alt="listing_image" style="height: 20rem;">
                <div class="card-img-overlay"></div>
                <div class="card-body">
                    <p class="card-text">
                        <b><%=listing.title%></b> <br>
                        ₹<%=listing.price.toLocaleString('en-IN')%> / night
                        <i class="tax-info">&nbsp; &nbsp;+18% gst</i>
                    </p>
                </div>
            </div>
            </a>
        </div>
    <% } %>
</div>
<script src="/js/taxSwitch.js"></script>